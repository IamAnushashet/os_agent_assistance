# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
env/
ENV/
.venv/

# Environment variables & secrets (Never commit API keys)
.env
.env.*
!.env.example

# Database runtime & WAL files
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.sqlite*

# Test & coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# Temporary and Office lock files
~$*
~*
*.tmp
*.bak
*.swp

# User runtime scratch & backups
scratch/
generated_documents/*.tmp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
