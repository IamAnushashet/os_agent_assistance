# ==============================================================================
# Autonomous Multi-Agent Windows OS Assistant - Environment Configuration
# ==============================================================================

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fallback, get at: https://console.groq.com/)
GROQ_API_KEY=

# Default Models
LLM_MODEL=gemini-3.5-flash
LLM_VISION_MODEL=gemini-3.5-flash

# LAN Mobile Remote Authentication (Auto-generated if left blank)
REMOTE_PAIRING_PIN=1234
REMOTE_AUTH_TOKEN=auto_generated_secure_token

# Speech / TTS Voice (e.g. en-US-ChristopherNeural, en-US-AriaNeural, en-US-GuyNeural)
DEFAULT_VOICE=en-US-ChristopherNeural
